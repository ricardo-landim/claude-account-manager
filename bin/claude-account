#!/usr/bin/env bash
# Profile manager for multiple Claude Code accounts on macOS.
# Secrets live exclusively in the macOS Keychain; this file never contains tokens.
#
# `use <name>` switches every auth layer atomically (Keychain slots, launchctl,
# ~/.claude.json metadata, Claude daemon). An OAuth profile is also projected into
# the native Keychain slot, which is where `claude agents` and background sessions
# read their credential. By default the daemon restarts and, when Orca is
# installed, Orca too; `--no-restart` stops nothing. The headless switcher
# (claude-account-autoswitch) always passes `--no-restart`.
#
# A setup-token has inference scope only, so the claude.ai connectors (Drive,
# Granola, ...) never load under it. `login <name>` gives an OAuth profile a full
# login of its own, kept in a separate Keychain item that Claude Code derives from
# CLAUDE_SECURESTORAGE_CONFIG_DIR. Claude Code forwards that variable to the
# daemon's background sessions (it lands in their providerEnv) but not the OAuth
# token, so such a profile needs nothing in the native slot.
#
# Background sessions are moved, not killed: `bg-restart` snapshots them, stops
# the daemon from the new profile's environment and resumes each one by id
# (deferred while any is busy). `claude-sessions` manages them one by one.
#
# `measure` reads the real rate-limit state of every profile from the
# anthropic-ratelimit-unified-* headers (a setup-token has inference scope only,
# so /api/oauth/usage is not available to it), which is what
# claude-account-autoswitch uses to decide.
set -euo pipefail

CONFIG_DIR="${CLAUDE_ACCOUNT_HOME:-$HOME/.config/claude-account}"
PROFILES_DIR="$CONFIG_DIR/profiles"
ACTIVE_FILE="$CONFIG_DIR/active"
WRAPPER_BIN="$HOME/bin/claude"
NATIVE_SERVICE="Claude Code-credentials"
OAT_PREFIX="sk-ant-oat01"   # setup-token prefix, used by renew to pick the token out of output
MEASURE_MODEL="claude-haiku-4-5-20251001"
MEASURE_SYSTEM="You are Claude Code, Anthropic's official CLI for Claude."
BG_PENDING_FILE="$CONFIG_DIR/bg-restart.pending"
BG_SNAPSHOT_FILE="$CONFIG_DIR/bg-restart.json"
BG_LOG="$CONFIG_DIR/bg-restart.log"
BG_LOCK_DIR="$CONFIG_DIR/bg-restart.lock"
DAEMON_PROFILE_FILE="$CONFIG_DIR/daemon-profile"
# Which native profile's /login sits in the live slot. A full-login profile leaves the
# slot alone, so after one the owner is not the previous profile.
NATIVE_OWNER_FILE="$CONFIG_DIR/native-owner"
BG_LOCK_STALE_MIN=10
# Pause between the worker's steps (stop, resume, identity check); tests set it to 0.
BG_SETTLE_S="${CLAUDE_ACCOUNT_BG_SETTLE:-2}"

die() { printf 'claude-account: ERROR: %s\n' "$*" >&2; exit 1; }
usage_error() { printf 'claude-account: ERROR: %s\n' "$*" >&2; exit 2; }
note() { printf 'claude-account: %s\n' "$*"; }

# One line in the Claude daemon log naming who stops sessions and why, so the next
# "every session died" has a cause on record. The daemon itself only logs
# "shutdown requested via control socket" or "settled <id> (killed)".
DAEMON_LOG="${CLAUDE_DAEMON_LOG:-$HOME/.claude/daemon.log}"
caller_chain() {
  local pid=$PPID out="" i=0 cmd
  while [ -n "$pid" ] && [ "$pid" -gt 1 ] && [ "$i" -lt 4 ]; do
    cmd="$(ps -o command= -p "$pid" 2>/dev/null | cut -c1-80 || true)"
    out="${out:+$out < }$pid:$cmd"
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
    i=$((i + 1))
  done
  printf '%s' "$out"
}
log_stop_reason() {
  [ -d "$(dirname "$DAEMON_LOG")" ] || return 0
  printf '[%s] [claude-account] %s | tty=%s | by %s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%S.000Z)" "$*" "$( { tty -s && tty; } 2>/dev/null || echo none)" "$(caller_chain)" \
    >>"$DAEMON_LOG" 2>/dev/null || true
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

find_native_bin() {
  if [ -n "${CLAUDE_NATIVE_BIN:-}" ]; then
    printf '%s\n' "$CLAUDE_NATIVE_BIN"
    return 0
  fi
  set -- \
    "$HOME/.local/bin/claude-stable" \
    "$HOME/.local/bin/claude" \
    "$HOME/.claude/local/claude" \
    /opt/homebrew/bin/claude \
    /usr/local/bin/claude
  for cand in "$@"; do
    if [ -x "$cand" ] && [ "$cand" != "$WRAPPER_BIN" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  while IFS= read -r cand; do
    if [ -x "$cand" ] && [ "$cand" != "$WRAPPER_BIN" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done < <(command -v -a claude 2>/dev/null || true)
  return 1
}

NATIVE_BIN="$(find_native_bin || true)"

ensure_base() {
  mkdir -p "$PROFILES_DIR"
  chmod 700 "$CONFIG_DIR" "$PROFILES_DIR" 2>/dev/null || true
  [ -n "$NATIVE_BIN" ] && [ -x "$NATIVE_BIN" ] || \
    die "native Claude Code binary not found; set CLAUDE_NATIVE_BIN=/path/to/claude"
  need jq
  need security
}

validate_name() {
  case "${1:-}" in
    ''|*[!a-zA-Z0-9._-]*) usage_error "invalid profile name: use letters, digits, dot, _ or -" ;;
  esac
}

profile_file() { printf '%s/%s.json' "$PROFILES_DIR" "$1"; }

load_profile() {
  PROFILE_NAME="$1"
  validate_name "$PROFILE_NAME"
  PROFILE_FILE="$(profile_file "$PROFILE_NAME")"
  [ -f "$PROFILE_FILE" ] || die "profile does not exist: $PROFILE_NAME"
  PROFILE_TYPE="$(jq -er '.type' "$PROFILE_FILE")"
  KEYCHAIN_SERVICE="$(jq -er '.keychainService' "$PROFILE_FILE")"
  PROFILE_LABEL="$(jq -r '.label // .name' "$PROFILE_FILE")"
  MEASURE_SERVICE="$(jq -r '.measureKeychainService // empty' "$PROFILE_FILE")"
  PROFILE_SUBSCRIPTION="$(jq -r '.subscription // "max"' "$PROFILE_FILE")"
  # Set by `login`: the OAuth profile runs on a full login in its own Keychain item.
  SECURE_DIR="$(jq -r '.secureStorageDir // empty' "$PROFILE_FILE")"
  case "$PROFILE_TYPE" in
    oauth_token|native_archive) ;;
    *) die "unknown profile type in $PROFILE_FILE: $PROFILE_TYPE" ;;
  esac
}

active_name() {
  [ -f "$ACTIVE_FILE" ] || return 1
  tr -d '[:space:]' < "$ACTIVE_FILE"
}

set_active() {
  tmp="$(mktemp "$CONFIG_DIR/.active.XXXXXX")"
  printf '%s\n' "$1" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$ACTIVE_FILE"
}

keychain_get() {
  security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null
}

keychain_has() {
  security find-generic-password -a "$USER" -s "$1" >/dev/null 2>&1
}

fingerprint() {
  printf '%s' "$1" | shasum -a 256 | cut -c1-12
}

write_profile() {
  name="$1" type="$2" service="$3" label="$4" measure="${5:-}"
  file="$(profile_file "$name")"
  tmp="$(mktemp "$PROFILES_DIR/.profile.XXXXXX")"
  jq -n \
    --arg name "$name" \
    --arg type "$type" \
    --arg service "$service" \
    --arg label "$label" \
    --arg measure "$measure" \
    '{version:2,name:$name,type:$type,keychainService:$service,label:$label}
     + (if $measure != "" then {measureKeychainService:$measure} else {} end)' > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"
}

# Copies one Keychain item into another, verified by fingerprint.
copy_keychain_item() {
  from="$1" to="$2"
  blob="$(keychain_get "$from")" || die "Keychain item missing: $from"
  security add-generic-password -U -a "$USER" -s "$to" -w "$blob" >/dev/null
  check="$(keychain_get "$to")"
  [ "$(fingerprint "$blob")" = "$(fingerprint "$check")" ] || die "copied credential does not match: $to"
  unset blob check
}

# Copies the live native credential into an archive slot, verified by fingerprint.
archive_native_if_present() {
  if keychain_has "$NATIVE_SERVICE"; then copy_keychain_item "$NATIVE_SERVICE" "$1"; fi
}

# The live native slot is the one credential every Claude Code process reads alike. The
# daemon behind `claude agents` and the background sessions it spawns do not inherit
# CLAUDE_CODE_OAUTH_TOKEN from the shell: they authenticate from this slot. Besides the
# account login the blob carries other keys (MCP server OAuth lives there), and every
# write below keeps them.
live_native_blob() { keychain_get "$NATIVE_SERVICE" || true; }

# absent | login (a real /login, with a refresh token) | token (a projected setup-token) | other
live_native_kind() {
  kind_blob="$(live_native_blob)"
  if [ -z "$kind_blob" ]; then
    echo absent
  else
    printf '%s' "$kind_blob" | jq -r '
      if type != "object" or (.claudeAiOauth | type) != "object" then "other"
      elif (.claudeAiOauth.refreshToken // "") != "" then "login"
      else "token" end' 2>/dev/null || echo other
  fi
  unset kind_blob
}

access_fingerprint_of() {
  access="$(keychain_get "$1" | jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null || true)"
  [ -n "$access" ] || { unset access; return 1; }
  fingerprint "$access"
  unset access
}

live_native_access_fingerprint() { access_fingerprint_of "$NATIVE_SERVICE"; }

# A setup-token lives one year. Its birth is read from the Keychain item's modification date
# (`add-oauth` rewrites the item with -U, which keeps the creation date but moves this one), so the
# projection can carry the token's real expiry. The daemon behind `claude agents` refreshes a
# credential only when its expiry is near, and with no refresh token that refresh fails and the
# daemon drops the credential: an expiry earlier than the token's would break the agents while the
# token still works (measured on 2.1.267: the daemon log reads "proactive refresh failed,
# signalling re-auth required"). A plain session ignores the expiry when there is no refresh token.
TOKEN_LIFETIME_DAYS=364
PROJECTION_FALLBACK_DAYS=330

keychain_written_epoch() {
  stamp="$(security find-generic-password -a "$USER" -s "$1" 2>/dev/null \
    | sed -n 's/.*"mdat"<timedate>=[^"]*"\([0-9]\{14\}\)Z.*/\1/p' | head -1)"
  [ -n "$stamp" ] || return 1
  date -j -u -f '%Y%m%d%H%M%S' "$stamp" +%s 2>/dev/null
}

# Epoch seconds when the setup-token in this Keychain item stops working.
token_expiry_epoch() {
  if created="$(keychain_written_epoch "$1")"; then
    printf '%s\n' $(( created + TOKEN_LIFETIME_DAYS * 86400 ))
  else
    printf '%s\n' $(( $(date +%s) + PROJECTION_FALLBACK_DAYS * 86400 ))
  fi
}

# Writes an OAuth profile into the live slot as a native-shaped credential: the setup-token
# as access token, no refresh token (a setup-token is long-lived and has nothing to refresh
# with) and the token's own expiry, so the daemon never tries to refresh it before it dies.
project_token_into_native() {
  expires=$(( $(token_expiry_epoch "$KEYCHAIN_SERVICE") * 1000 ))
  base="$(live_native_blob)"
  printf '%s' "$base" | jq -e 'type == "object"' >/dev/null 2>&1 || base='{}'
  blob="$(printf '%s' "$base" | CA_TOKEN="$1" jq -c --argjson e "$expires" --arg s "$PROFILE_SUBSCRIPTION" \
    '.claudeAiOauth = {accessToken: env.CA_TOKEN, refreshToken: null, expiresAt: $e,
                       scopes: ["user:inference"], subscriptionType: $s}')"
  security add-generic-password -U -a "$USER" -s "$NATIVE_SERVICE" -w "$blob" >/dev/null
  unset base blob
  [ "$(live_native_access_fingerprint || true)" = "$(fingerprint "$1")" ] || \
    die "projected credential does not match the profile token"
}

# Restores an archived login into the live slot, keeping the other keys of the live blob.
restore_native_active() {
  blob="$(keychain_get "$1")" || die "native archive missing from Keychain"
  live="$(live_native_blob)"
  if printf '%s' "$live" | jq -e 'type == "object"' >/dev/null 2>&1; then
    blob="$(printf '%s\n%s\n' "$blob" "$live" | jq -cs '.[0] + (.[1] | del(.claudeAiOauth))')"
  fi
  security add-generic-password -U -a "$USER" -s "$NATIVE_SERVICE" -w "$blob" >/dev/null
  unset blob live
}

LAST_LOGIN_ARCHIVE="Claude Code-credentials-last-login-archive"

# A real /login in the live slot is never lost. When the active profile is native it owns
# the slot, and its archive is refreshed (the login rotates its refresh token while it sits
# there). Otherwise the login came from a /login inside Claude Code: it is kept in a
# last-login archive that `import-native <name> --last-login` turns into a profile.
preserve_live_login() {
  [ "$(live_native_kind)" = login ] || return 0
  current="$(active_name 2>/dev/null || true)"
  if [ -n "$current" ] && [ -f "$(profile_file "$current")" ] && \
     [ "$(jq -r '.type' "$(profile_file "$current")")" = native_archive ]; then
    archive_native_if_present "$(jq -r '.keychainService' "$(profile_file "$current")")"
    return 0
  fi
  archive_native_if_present "$LAST_LOGIN_ARCHIVE"
  note "a /login found in the native slot was kept as '$LAST_LOGIN_ARCHIVE' (claude-account import-native <name> --last-login)"
}

# True when the caller descends from the Claude daemon (a background agent running us):
# a full daemon stop would terminate the caller itself.
inside_background_agent() {
  pid=$$
  while [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
    case "$(ps -o command= -p "$pid" 2>/dev/null || true)" in
      *"daemon run"*|*bg-pty-host*) return 0 ;;
    esac
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
  done
  return 1
}

# New background agents start from the slot the daemon hands them. A full stop ends every
# running agent; --keep-workers (for --keep-agents, and whenever we run inside an agent)
# keeps them alive on the account they started with.
restart_claude_daemon() {
  if [ "$1" = true ] || inside_background_agent; then
    log_stop_reason "daemon stop --keep-workers: switch to profile '$(active_name 2>/dev/null || true)', agents kept"
    "$NATIVE_BIN" daemon stop --any --keep-workers >/dev/null 2>&1 || true
    note "daemon restarted; running agents keep their account until respawned (claude respawn)"
  else
    log_stop_reason "daemon stop: switch to profile '$(active_name 2>/dev/null || true)', every agent ends"
    "$NATIVE_BIN" daemon stop --any >/dev/null 2>&1 || true
  fi
}

strip_stale_account_metadata() {
  file="$HOME/.claude.json"
  [ -f "$file" ] || return 0
  jq -e 'has("oauthAccount")' "$file" >/dev/null 2>&1 || return 0
  stamp="$(date +%Y%m%d-%H%M%S)"
  cp "$file" "$file.bak-claude-account-$stamp"
  tmp="$(mktemp)"
  jq 'del(.oauthAccount)' "$file" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"
  note "previous oauthAccount metadata archived at $file.bak-claude-account-$stamp"
}

schedule_orca_restart() {
  helper="$HOME/.local/lib/claude-account-manager/restart-orca.sh"
  if [ ! -x "$helper" ]; then
    note "restart your terminal sessions (and Orca, if you use it) for the switch to take effect"
    return 0
  fi
  nohup "$helper" >/tmp/claude-account-restart-orca.log 2>&1 </dev/null &
  note "Orca will restart shortly"
}

validate_token() {
  auth_json="$(CLAUDE_CODE_OAUTH_TOKEN="$1" "$NATIVE_BIN" auth status 2>/dev/null || true)"
  [ "$(printf '%s' "$auth_json" | jq -r '.loggedIn // false' 2>/dev/null)" = true ]
}

cmd_add_oauth() {
  name="${1:-}"
  shift || true
  existing=false
  measure_for=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --existing) existing=true ;;
      --measure-for) shift; measure_for="${1:-}" ;;
      *) usage_error "unknown option: $1" ;;
    esac
    shift
  done
  validate_name "$name"
  service="Claude Code OAuth Token - $name"
  if [ "$existing" = true ]; then
    token="$(keychain_get "$service")" || die "no Keychain item named '$service'"
  else
    printf 'Paste the setup-token for profile %s (hidden input): ' "$name" >&2
    IFS= read -r -s token
    printf '\n' >&2
  fi
  case "$token" in
    sk-ant-oat01-*) ;;
    *) unset token; die "unexpected setup-token format" ;;
  esac
  validate_token "$token" || { unset token; die "token rejected by Claude Code"; }
  [ "$existing" = true ] || security add-generic-password -U -a "$USER" -s "$service" -w "$token" >/dev/null
  unset token
  if [ -n "$measure_for" ]; then
    # This token only measures the rate-limit state of a native profile of the
    # same account; it never becomes the active credential by itself.
    validate_name "$measure_for"
    [ -f "$(profile_file "$measure_for")" ] || die "profile does not exist: $measure_for"
    tmp="$(mktemp "$PROFILES_DIR/.profile.XXXXXX")"
    jq --arg m "$service" '.measureKeychainService = $m' "$(profile_file "$measure_for")" > "$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$(profile_file "$measure_for")"
    note "profile '$measure_for' now measures through the Keychain item '$service'"
    return 0
  fi
  write_profile "$name" oauth_token "$service" "$name (OAuth setup-token)"
  note "OAuth profile '$name' stored in the Keychain"
}

# Guided renewal of an expired or revoked setup-token. Runs `claude setup-token`
# (browser login), picks the token out of its output, checks which account it
# belongs to, asks once, stores it over the profile's Keychain item and measures
# the profile right away. For a native_archive profile it renews the token that
# profile measures through. Nothing is written until the user confirms.
cmd_renew() {
  name="${1:-}"
  shift || true
  yes=false; token_stdin=false; account_opt=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -y|--yes) yes=true ;;
      --token-stdin) token_stdin=true; yes=true ;;
      --account) shift; account_opt="${1:-}" ;;
      *) usage_error "unknown option: $1" ;;
    esac
    shift
  done
  [ -n "$name" ] || usage_error "usage: claude-account renew <name> [--yes] [--token-stdin] [--account <email>]"
  load_profile "$name"
  [ -n "$NATIVE_BIN" ] || die "native claude binary not found (set CLAUDE_NATIVE_BIN)"
  case "$PROFILE_TYPE" in
    oauth_token) service="$KEYCHAIN_SERVICE"; what="sign-in oat" ;;
    native_archive)
      [ -n "$MEASURE_SERVICE" ] || die "profile '$name' is a native login; it has no setup-token to renew (use /login inside Claude Code)"
      service="$MEASURE_SERVICE"; what="quota-measuring oat" ;;
  esac
  account="$account_opt"
  [ -n "$account" ] || account="$(jq -r '.account // empty' "$PROFILE_FILE")"
  [ -n "$account" ] || account="$(printf '%s' "$PROFILE_LABEL" | grep -oE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+' | head -1 || true)"

  # Colours only on a terminal and never under NO_COLOR.
  if [ -t 2 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
    B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; N=$'\033[0m'
  else
    B=""; D=""; G=""; Y=""; R=""; N=""
  fi
  ask() {  # <prompt> -> reply on stdout; empty reply on EOF
    printf '%s' "$1" >&2
    IFS= read -r reply || reply=""
    printf '%s' "$reply"
  }

  if [ "$token_stdin" = true ]; then
    IFS= read -r oat || :   # EOF without newline still assigns
    oat="$(printf '%s' "$oat" | grep -oE "${OAT_PREFIX}-[A-Za-z0-9_-]+" | head -1 || true)"
    [ -n "$oat" ] || die "no setup-token on stdin; nothing changed"
    renew_store_token
    return 0
  fi
  printf '\n%sRenew %s%s\n' "$B" "$what" "$N" >&2
  printf '  profile  %s\n' "$name" >&2
  printf '  account  %s\n\n' "${account:-${Y}not recorded yet (you will be asked after the login)$N}" >&2
  printf '%s1/3  Browser login%s\n' "$B" "$N" >&2
  printf '     Sign in with the %s%s%s account and approve. If a code is shown, paste it below.\n' "$B" "${account:-$name}" "$N" >&2
  if [ "$yes" != true ]; then
    printf '     %sEnter%s opens the browser, %sCtrl-C%s aborts. ' "$B" "$N" "$B" "$N" >&2
    IFS= read -r _ || { printf '\n' >&2; die "no terminal input; aborted before opening the browser"; }
  fi
  capture="$(mktemp "${TMPDIR:-/tmp}/claude-account-renew.XXXXXX")"
  chmod 600 "$capture"
  trap 'rm -f "$capture"' EXIT INT TERM
  # `script` lends the child a pseudo-terminal, so its TUI draws in place
  # instead of repainting whole frames into a pipe. The stream is copied raw to
  # $capture (where the oat is picked up) and the terminal only ever sees the
  # oat masked. perl keeps the escape codes untouched.
  printf '\n' >&2
  if [ -t 2 ] && [ -e /dev/tty ]; then
    script -q /dev/null "$NATIVE_BIN" setup-token 2>&1 </dev/tty \
      | tee "$capture" \
      | perl -pe "BEGIN{\$|=1} s/${OAT_PREFIX}-[A-Za-z0-9_-]+/${OAT_PREFIX}-(stored in the Keychain, hidden)/g" >&2 \
      || true
  else
    "$NATIVE_BIN" setup-token > "$capture" 2>&1 || true
  fi
  oat="$(tr -d '\r' < "$capture" | grep -oE "${OAT_PREFIX}-[A-Za-z0-9_-]+" | tail -1 || true)"
  rm -f "$capture"
  trap - EXIT INT TERM
  [ -n "$oat" ] || die "no setup-token came out of the browser login; nothing changed"

  printf '\n%s2/3  Checking the oat%s\n' "$B" "$N" >&2
  renew_store_token
}

# Validates $oat against the API, asks (unless --yes) and stores it under
# $service for profile $name; prints the measurement line on stdout.
renew_store_token() {
  validate_token "$oat" || { unset oat; die "token rejected by Claude Code; nothing changed"; }
  # A setup-token carries no e-mail (inference scope only), so the account is
  # shown from the profile and the quota headers are the only live evidence.
  line="$(measure_token_line "$name" "$oat")"
  status="$(printf '%s' "$line" | cut -d, -f2)"
  u5="$(printf '%s' "$line" | cut -d, -f4)"; u7="$(printf '%s' "$line" | cut -d, -f6)"; ov="$(printf '%s' "$line" | cut -d, -f8)"
  case "$status" in
    allowed|rejected)
      printf '     %s✓ valid%s   5h window %s%% used, 7d window %s%%, overage %s\n' "$G" "$N" \
        "$(awk -v v="${u5:-0}" 'BEGIN{printf "%d", v*100}')" "$(awk -v v="${u7:-0}" 'BEGIN{printf "%d", v*100}')" "${ov:-?}" >&2 ;;
    *) unset oat; die "token accepted locally but the API refuses it ($line); nothing changed" ;;
  esac
  if [ -z "$account" ] && [ "$yes" != true ]; then
    account="$(ask "     Which e-mail did you sign in with? (Enter to skip) ")"
  fi
  if [ "$yes" != true ]; then
    printf '     %sStore it for %s?%s [y/N] ' "$B" "$name" "$N" >&2
    IFS= read -r answer || answer=""
    case "$answer" in y|Y|yes|YES|s|S|sim|SIM) ;; *) unset oat; die "aborted, nothing changed" ;; esac
  fi

  printf '%s3/3  Storing%s\n' "$B" "$N" >&2
  security add-generic-password -U -a "$USER" -s "$service" -w "$oat" >/dev/null
  unset oat
  if [ -n "$account" ]; then
    tmp="$(mktemp "$PROFILES_DIR/.profile.XXXXXX")"
    jq --arg a "$account" '.account = $a' "$PROFILE_FILE" > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$PROFILE_FILE"
  fi
  if [ "$PROFILE_TYPE" = oauth_token ] && [ "$(active_name 2>/dev/null || true)" = "$name" ]; then
    oat="$(keychain_get "$service")"
    project_token_into_native "$oat"
    launchctl setenv CLAUDE_CODE_OAUTH_TOKEN "$oat"
    unset oat
    printf '     profile is active: native slot and launchctl updated, new sessions use the renewed oat\n' >&2
  fi
  printf '     %s✓ done%s   %s renewed%s\n\n' "$G" "$N" "$name" "${account:+ ($account)}" >&2
  note "renewed: $line"
}

# One measurement line for an arbitrary oat (used by renew before storing).
measure_token_line() {
  name="$1"; oat="$2"
  hdr="$(mktemp "${TMPDIR:-/tmp}/claude-account-measure.XXXXXX")"
  http="$(curl -s -o /dev/null -D "$hdr" -w '%{http_code}' --max-time 20 \
    https://api.anthropic.com/v1/messages \
    -H "authorization: Bearer $oat" \
    -H "anthropic-version: 2023-06-01" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "content-type: application/json" \
    -d "$(jq -cn --arg m "$MEASURE_MODEL" --arg s "$MEASURE_SYSTEM" \
      '{model:$m,max_tokens:1,system:[{type:"text",text:$s}],messages:[{role:"user",content:"."}]}')" \
    2>/dev/null || printf '000')"
  h() { grep -i "^anthropic-ratelimit-unified-$1:" "$hdr" | head -1 | cut -d: -f2- | tr -d ' \r' || true; }
  s5="$(h 5h-status)"; u5="$(h 5h-utilization)"; r5="$(h 5h-reset)"
  s7="$(h 7d-status)"; u7="$(h 7d-utilization)"; r7="$(h 7d-reset)"
  so="$(h overage-status)"; ou="$(h overage-in-use)"
  rm -f "$hdr"
  status=unknown
  if [ "$http" = 429 ]; then status=rejected
  elif [ "$http" -ge 200 ] 2>/dev/null && [ "$http" -lt 300 ]; then
    if [ "$s5" = rejected ] || [ "$s7" = rejected ]; then status=rejected
    # allowed_warning: the window crossed the warning threshold but still serves requests.
    elif [ "${s5%_warning}" = allowed ] && [ "${s7%_warning}" = allowed ]; then status=allowed
    fi
  fi
  printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' "$name" "$status" "$http" "${u5:-}" "${r5:-}" "${u7:-}" "${r7:-}" "${so:-}" "${ou:-false}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

cmd_import_native() {
  name="${1:-primary}"
  shift || true
  validate_name "$name"
  from="$NATIVE_SERVICE"
  case "${1:-}" in
    '') ;;
    --last-login) from="$LAST_LOGIN_ARCHIVE" ;;
    *) usage_error "unknown option: $1" ;;
  esac
  keychain_get "$from" | jq -e '(.claudeAiOauth.refreshToken // "") != ""' >/dev/null 2>&1 || \
    die "'$from' holds no /login (only a projected setup-token or MCP keys); log in with /login first"
  service="Claude Code-credentials-$name-archive"
  copy_keychain_item "$from" "$service"
  email=""
  if [ "$from" = "$NATIVE_SERVICE" ]; then
    email="$(CLAUDE_CODE_OAUTH_TOKEN='' "$NATIVE_BIN" auth status 2>/dev/null | jq -r '.email // empty' || true)"
  fi
  write_profile "$name" native_archive "$service" "$name (native login${email:+ $email})"
  [ "$from" = "$NATIVE_SERVICE" ] && printf '%s\n' "$name" > "$NATIVE_OWNER_FILE"
  note "native credential imported as profile '$name'${email:+ ($email)}"
}

# The account a secureStorageDir profile really runs on: signed in, and the
# e-mail the profile recorded at login (a copied profile JSON, a deleted Keychain
# item or a revoked refresh token all fail here instead of after the switch).
validate_secure_login() {
  local status expected email
  status="$(env -u CLAUDE_CODE_OAUTH_TOKEN CLAUDE_SECURESTORAGE_CONFIG_DIR="$SECURE_DIR" "$NATIVE_BIN" auth status 2>/dev/null || true)"
  [ "$(jq -r '.loggedIn // false' <<<"$status" 2>/dev/null)" = true ] || return 1
  # The e-mail comes from the shared oauthAccount metadata, which `use` strips and any
  # login rewrites: compare it only when present.
  expected="$(jq -r '.account // empty' "$PROFILE_FILE")"
  email="$(jq -r '.email // empty' <<<"$status")"
  [ -z "$expected" ] || [ -z "$email" ] || [ "$email" = "$expected" ]
}

# One-time browser login that gives an oauth_token profile the full scopes a
# setup-token lacks (claude.ai connectors). It lands in its own Keychain item,
# so the native slot and every other profile stay untouched, and Claude Code
# keeps refreshing it from then on: switching never asks for a login again.
cmd_login() {
  local name="${1:-}" dir expected status email tmp
  [ -n "$name" ] || usage_error "usage: claude-account login <name>"
  shift
  [ "$#" -eq 0 ] || usage_error "unknown option: $1"
  load_profile "$name"
  [ "$PROFILE_TYPE" = oauth_token ] || die "profile '$name' is a native login already; it loads the claude.ai connectors as is"
  dir="$CONFIG_DIR/logins/$name"
  mkdir -p "$dir"
  chmod 700 "$CONFIG_DIR/logins" "$dir"
  expected="$(jq -r '.account // empty' "$PROFILE_FILE")"
  note "login: sign in as ${expected:-the '$name' account} in the browser; other profiles are not touched"
  env -u CLAUDE_CODE_OAUTH_TOKEN CLAUDE_SECURESTORAGE_CONFIG_DIR="$dir" "$NATIVE_BIN" auth login ${expected:+--email "$expected"} \
    || die "login did not finish"
  status="$(env -u CLAUDE_CODE_OAUTH_TOKEN CLAUDE_SECURESTORAGE_CONFIG_DIR="$dir" "$NATIVE_BIN" auth status 2>/dev/null || true)"
  [ "$(jq -r '.loggedIn // false' <<<"$status")" = true ] || die "login: not signed in after the browser step"
  email="$(jq -r '.email // empty' <<<"$status")"
  if [ -n "$expected" ] && [ "$email" != "$expected" ]; then
    die "login: signed in as $email, but profile '$name' is $expected; run it again with the right account"
  fi
  tmp="$(mktemp "$PROFILES_DIR/.profile.XXXXXX")"
  jq --arg d "$dir" --arg a "$email" '.secureStorageDir = $d | if $a != "" then .account = $a else . end' \
    "$PROFILE_FILE" > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$PROFILE_FILE"
  note "login: profile '$name' now uses the full login of ${email:-?} (claude.ai connectors); its setup-token stays for measure"
  if [ "$(active_name 2>/dev/null || true)" = "$name" ]; then
    launchctl unsetenv CLAUDE_CODE_OAUTH_TOKEN >/dev/null 2>&1 || true
    launchctl setenv CLAUDE_SECURESTORAGE_CONFIG_DIR "$dir"
    cmd_bg_restart --force
  else
    note "help: claude-account use $name"
  fi
}

# Background sessions live under one long-lived daemon that keeps the
# environment of whoever spawned it, so a profile switch only reaches them when
# the daemon is restarted from the new profile's environment. `--resume <id>`
# plus a prompt continues the same session; any extra flag (-n, --model) makes
# Claude Code start a copy under a new id (both tested 2026-10-07).
# Callers run apply_profile_env first: `agents --json` spawns the daemon when
# none is running, and it must be born with the right account.
bg_sessions_json() {
  local raw
  raw="$("$NATIVE_BIN" agents --json 2>/dev/null)" || return 1
  jq -ce 'if type == "array" then [.[] | select(.kind == "background") | {id, sessionId, cwd, name, status}] else error end' \
    <<<"$raw" 2>/dev/null || return 1
}

# Held by the worker from snapshot to the last resume. A second restart while
# one runs (autoswitch firing a pending one and then `use`, two quick `use`)
# would snapshot half-resumed sessions and stop the daemon under them.
bg_lock_busy() {
  [ -d "$BG_LOCK_DIR" ] || return 1
  if [ $(( $(date +%s) - $(stat -f %m "$BG_LOCK_DIR") )) -ge $((BG_LOCK_STALE_MIN * 60)) ]; then
    rmdir "$BG_LOCK_DIR" 2>/dev/null || true
    return 1
  fi
  return 0
}

cmd_bg_restart() {
  local force=false if_pending=false sessions count busy
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force) force=true ;;
      --if-pending) if_pending=true ;;
      -h|--help) printf 'usage: claude-account bg-restart [--force] [--if-pending]\n'; return 0 ;;
      *) usage_error "unknown option: $1" ;;
    esac
    shift
  done
  if [ "$if_pending" = true ] && [ ! -f "$BG_PENDING_FILE" ]; then
    note "bg-restart: nothing pending"
    return 0
  fi
  apply_profile_env
  if bg_lock_busy; then
    [ -f "$BG_PENDING_FILE" ] || printf '%s\n' "$active" > "$BG_PENDING_FILE"
    note "bg-restart: deferred, another restart is running (lock: $BG_LOCK_DIR)"
    return 0
  fi
  if ! sessions="$(bg_sessions_json)"; then
    [ -f "$BG_PENDING_FILE" ] || printf '%s\n' "$active" > "$BG_PENDING_FILE"
    note "bg-restart: could not list background sessions (claude agents --json failed); kept pending"
    return 1
  fi
  count="$(jq length <<<"$sessions")"
  if [ "$count" -eq 0 ]; then
    rm -f "$BG_PENDING_FILE"
    log_stop_reason "daemon stop: bg-restart to profile '$active', 0 background sessions"
    "$NATIVE_BIN" daemon stop --any >/dev/null 2>&1 || true
    printf '%s\n' "$active" > "$DAEMON_PROFILE_FILE"
    note "bg-restart: 0 background sessions; daemon stopped, the next one starts under '$active'"
    return 0
  fi
  # "shell" is idle with a background shell alive, which the restart would kill.
  busy="$(jq -r '[.[] | select(.status == "busy" or .status == "shell") | .name // .id] | join(",")' <<<"$sessions")"
  if [ -n "$busy" ] && [ "$force" != true ]; then
    [ -f "$BG_PENDING_FILE" ] || printf '%s\n' "$active" > "$BG_PENDING_FILE"
    note "bg-restart: deferred, busy: $busy"
    note "help: the autoswitch finishes it once they are idle (policy move_agents); now: claude-account bg-restart --force"
    return 0
  fi
  if ! mkdir "$BG_LOCK_DIR" 2>/dev/null; then
    [ -f "$BG_PENDING_FILE" ] || printf '%s\n' "$active" > "$BG_PENDING_FILE"
    note "bg-restart: deferred, another restart just started"
    return 0
  fi
  printf '%s\n' "$sessions" > "$BG_SNAPSHOT_FILE"
  rm -f "$BG_PENDING_FILE"
  # Double fork + setsid: the caller is often one of the sessions the daemon
  # stop is about to kill, and the worker must outlive it.
  perl -MPOSIX -e 'exit 0 if fork; POSIX::setsid(); exit 0 if fork; exec @ARGV' \
    "$0" _bg-restart-worker "$BG_SNAPSHOT_FILE" </dev/null >>"$BG_LOG" 2>&1
  note "bg-restart: moving $count background session(s) to '$active' (log: $BG_LOG)"
  note "help: claude-account bg-status"
}

cmd_bg_restart_worker() {
  local snapshot="$1" n i sid cwd name wake
  apply_profile_env
  wake="claude-account: the background-session daemon was restarted to move to profile '$active'. Your monitors and background shells died in the restart; start again what was running and carry on where you left off. If nothing was running, just reply ok."
  printf '%s start profile=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$active"
  trap 'rmdir "$BG_LOCK_DIR" 2>/dev/null || true' EXIT
  if ! jq -e 'type == "array" and length > 0' "$snapshot" >/dev/null 2>&1; then
    printf 'abort: snapshot unreadable or empty, daemon left running\n'
    return 1
  fi
  sleep "$BG_SETTLE_S"
  log_stop_reason "daemon stop: bg-restart moves $(jq length "$snapshot") session(s) to profile '$active', resumed with the same ids"
  "$NATIVE_BIN" daemon stop --any || true
  sleep "$BG_SETTLE_S"
  n="$(jq length "$snapshot")"
  for ((i = 0; i < n; i++)); do
    sid="$(jq -r ".[$i].sessionId" "$snapshot")"
    cwd="$(jq -r ".[$i].cwd" "$snapshot")"
    name="$(jq -r ".[$i].name // \"-\"" "$snapshot")"
    if (cd "$cwd" && "$NATIVE_BIN" --bg --resume "$sid" "$wake" </dev/null >/dev/null); then
      printf 'resumed %s %s\n' "$name" "$sid"
    else
      printf 'resume_failed %s %s cwd=%s\n' "$name" "$sid" "$cwd"
    fi
  done
  printf '%s\n' "$active" > "$DAEMON_PROFILE_FILE"
  sleep "$BG_SETTLE_S"
  bg_restore_identity "$snapshot"
  printf '%s end\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

# The daemon resumes a conversation into the job whose short id is the session
# id prefix; when the session had lived under another job (a copy, a fork), the
# new job starts with no saved flags, so it loses its name (Claude Code titles
# it from the wake prompt) and its permission mode (falls back to the default).
# The saved flags live in ~/.claude/jobs/<id>/state.json (respawnFlags), and
# `claude respawn <id>` restarts one session with them, keeping its id.
bg_restore_identity() {
  local snapshot="$1" now n i sid name id state bypass flags_ok
  bypass=false
  [ "$(jq -r '.permissions.defaultMode // empty' "$HOME/.claude/settings.json" 2>/dev/null)" = bypassPermissions ] && bypass=true
  now="$(bg_sessions_json)" || { printf 'identity_skip: could not list sessions\n'; return 0; }
  n="$(jq length "$snapshot")"
  for ((i = 0; i < n; i++)); do
    sid="$(jq -r ".[$i].sessionId" "$snapshot")"
    name="$(jq -r ".[$i].name // empty" "$snapshot")"
    id="$(jq -r --arg s "$sid" '.[] | select(.sessionId == $s) | .id' <<<"$now" | head -1)"
    state="$HOME/.claude/jobs/$id/state.json"
    [ -n "$id" ] && [ -f "$state" ] || { printf 'identity_skip %s (job not found)\n' "$sid"; continue; }
    flags_ok="$(jq -r --arg n "$name" --argjson b "$bypass" '
      (($n == "" or .name == $n) and
       (($b | not) or (.respawnFlags | index("--dangerously-skip-permissions") != null)))' "$state")"
    [ "$flags_ok" = true ] && continue
    jq --arg n "$name" --argjson b "$bypass" '
      def drop(f): . as $a | [range(0; length)] | map(select(($a[.] | f) or (. > 0 and ($a[. - 1] | f) and ($a[.] | startswith("-") | not)) | not)) | map($a[.]);
      .respawnFlags = ((.respawnFlags // [])
        | if $n != "" then drop(. == "--name" or . == "-n") | ["--name", $n] + . else . end
        | if $b then drop(. == "--permission-mode") | map(select(. != "--dangerously-skip-permissions")) + ["--dangerously-skip-permissions"] else . end)
      | if $n != "" then .name = $n | .nameSource = "user" else . end' "$state" > "$state.tmp" \
      && mv "$state.tmp" "$state"
    if "$NATIVE_BIN" respawn "$id" >/dev/null 2>&1; then
      printf 'identity_restored %s %s\n' "${name:--}" "$id"
    else
      printf 'identity_respawn_failed %s %s\n' "${name:--}" "$id"
    fi
  done
}

cmd_bg_status() {
  local sessions daemon_profile missing
  apply_profile_env
  sessions="$(bg_sessions_json)" || { sessions='[]'; printf 'warning: claude agents --json failed, session list unavailable\n'; }
  daemon_profile="$(cat "$DAEMON_PROFILE_FILE" 2>/dev/null || echo unknown)"
  printf 'active: %s\ndaemon_profile: %s\npending: %s\n' "$active" "$daemon_profile" \
    "$(cat "$BG_PENDING_FILE" 2>/dev/null || echo no)"
  printf 'sessions[%s]{id,name,status}:\n' "$(jq length <<<"$sessions")"
  jq -r '.[] | "  \(.id),\(.name // "-"),\(.status)"' <<<"$sessions"
  if [ -f "$BG_SNAPSHOT_FILE" ]; then
    missing="$(jq -r --argjson now "$sessions" \
      '[.[] | .sessionId as $s | select([$now[].sessionId] | index($s) | not) | .name // .id] | join(",")' \
      "$BG_SNAPSHOT_FILE")"
    [ -n "$missing" ] && printf 'missing_since_last_restart: %s\n' "$missing"
  fi
  if [ "$daemon_profile" != "$active" ]; then
    printf 'help: claude-account bg-restart\n'
  fi
}

cmd_use() {
  name="${1:-}"
  shift || true
  restart=true
  keep_agents=false
  move_agents=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --restart-orca) restart=true ;;
      --no-restart) restart=false ;;
      --keep-agents) keep_agents=true ;;
      --move-agents) move_agents=true ;;
      *) usage_error "unknown option: $1" ;;
    esac
    shift
  done
  load_profile "$name"

  # Validate before touching any layer.
  case "$PROFILE_TYPE${SECURE_DIR:+:full}" in
    oauth_token:full)
      validate_secure_login || die "full login of profile '$name' is missing or signed out; run: claude-account login $name"
      ;;
    oauth_token)
      token="$(keychain_get "$KEYCHAIN_SERVICE")" || die "token missing from Keychain: $KEYCHAIN_SERVICE"
      validate_token "$token" || { unset token; die "OAuth for profile '$name' was rejected"; }
      ;;
    native_archive)
      keychain_get "$KEYCHAIN_SERVICE" | jq -e '(.claudeAiOauth.refreshToken // "") != ""' >/dev/null 2>&1 || \
        die "the archive of profile '$name' holds no /login; log in with /login, then: claude-account import-native $name"
      ;;
  esac

  # The /login in the live slot belongs to the native profile recorded as its owner; a
  # full-login profile in between never displaced it, and it kept rotating its refresh
  # token. Archive it into that owner, never into whichever profile was active last.
  owner="$(cat "$NATIVE_OWNER_FILE" 2>/dev/null || true)"
  if [ -z "$owner" ]; then
    # No record yet (installed while a native profile was active): that profile owns it.
    current="$(active_name 2>/dev/null || true)"
    if [ -n "$current" ] && [ -f "$(profile_file "$current")" ] && \
       [ "$(jq -r '.type' "$(profile_file "$current")")" = native_archive ]; then
      owner="$current"
      printf '%s\n' "$owner" > "$NATIVE_OWNER_FILE"
    fi
  fi
  if [ -n "$owner" ] && [ "$(live_native_kind)" = login ] && [ -f "$(profile_file "$owner")" ] && \
     [ "$(jq -r '.type' "$(profile_file "$owner")")" = native_archive ]; then
    archive_native_if_present "$(jq -r '.keychainService' "$(profile_file "$owner")")"
  else
    preserve_live_login
  fi
  case "$PROFILE_TYPE" in
    oauth_token)
      if [ -n "$SECURE_DIR" ]; then
        launchctl unsetenv CLAUDE_CODE_OAUTH_TOKEN >/dev/null 2>&1 || true
        launchctl setenv CLAUDE_SECURESTORAGE_CONFIG_DIR "$SECURE_DIR"
      else
        project_token_into_native "$token"
        rm -f "$NATIVE_OWNER_FILE"
        launchctl setenv CLAUDE_CODE_OAUTH_TOKEN "$token"
        launchctl unsetenv CLAUDE_SECURESTORAGE_CONFIG_DIR >/dev/null 2>&1 || true
        unset token
      fi
      strip_stale_account_metadata
      ;;
    native_archive)
      launchctl unsetenv CLAUDE_CODE_OAUTH_TOKEN >/dev/null 2>&1 || true
      launchctl unsetenv CLAUDE_SECURESTORAGE_CONFIG_DIR >/dev/null 2>&1 || true
      restore_native_active "$KEYCHAIN_SERVICE"
      printf '%s\n' "$name" > "$NATIVE_OWNER_FILE"
      ;;
  esac

  set_active "$name"
  note "active profile: $name ($PROFILE_TYPE${SECURE_DIR:+, full login})"
  if [ "$restart" = true ]; then
    if [ "$keep_agents" = true ]; then
      restart_claude_daemon true
    else
      # A manual switch moves everything now: a busy session is cut and comes back
      # with the wake prompt. Only the headless switcher (--move-agents) waits.
      cmd_bg_restart --force || true
    fi
    schedule_orca_restart
  elif [ "$move_agents" = true ]; then
    cmd_bg_restart || true
  else
    note "--no-restart: nothing was stopped; new sessions use '$name', open sessions and running agents keep their account until restarted"
  fi
}

# Interactive screen (Ink). Looks for the wizard next to this script (repo
# checkout) or in the installed lib dir; the CLI stays the engine underneath.
cmd_wizard() {
  for dir in "$(dirname "$0")/../wizard" "$HOME/.local/lib/claude-account-manager/wizard" "${CLAUDE_ACCOUNT_WIZARD_DIR:-}"; do
    [ -n "$dir" ] && [ -f "$dir/index.mjs" ] && [ -d "$dir/node_modules" ] && break
    dir=""
  done
  [ -n "$dir" ] || die "wizard not installed; run install.sh (needs node >= 22)"
  node_bin="$(command -v node || true)"
  [ -n "$node_bin" ] || for c in /opt/homebrew/bin/node /usr/local/bin/node; do [ -x "$c" ] && node_bin="$c" && break; done
  [ -n "$node_bin" ] || die "node not found (brew install node)"
  major="$("$node_bin" -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
  [ "$major" -ge 22 ] 2>/dev/null || die "the wizard needs node 22 or newer (found $("$node_bin" --version 2>/dev/null || echo '?') at $node_bin)"
  CLAUDE_ACCOUNT_BIN="$0" CLAUDE_NATIVE_BIN="$NATIVE_BIN" CLAUDE_ACCOUNT_HOME="$CONFIG_DIR" exec "$node_bin" "$dir/index.mjs" "$@"
}

cmd_list() {
  active="$(active_name 2>/dev/null || true)"
  found=false
  for file in "$PROFILES_DIR"/*.json; do
    [ -f "$file" ] || continue
    found=true
    name="$(jq -r '.name' "$file")"
    type="$(jq -r '.type' "$file")"
    label="$(jq -r '.label // .name' "$file")"
    mark=' '
    [ "$name" = "$active" ] && mark='*'
    printf '%s %-16s %-15s %s\n' "$mark" "$name" "$type" "$label"
  done
  [ "$found" = true ] || note "no profiles registered (0 profiles)"
}

cmd_status() {
  active="$(active_name 2>/dev/null || true)"
  [ -n "$active" ] || die "no active profile"
  load_profile "$active"
  printf 'profile=%s\ntype=%s\nlabel=%s\n' "$PROFILE_NAME" "$PROFILE_TYPE" "$PROFILE_LABEL"
  if secret="$(keychain_get "$KEYCHAIN_SERVICE" 2>/dev/null)"; then
    printf 'keychain=present\nfingerprint=%s\n' "$(fingerprint "$secret")"
  else
    printf 'keychain=absent\n'
  fi
  launch_value="$(launchctl getenv CLAUDE_CODE_OAUTH_TOKEN 2>/dev/null || true)"
  if [ -n "$launch_value" ]; then
    printf 'launchctl_oauth=present\nlaunchctl_fingerprint=%s\n' "$(fingerprint "$launch_value")"
  else
    printf 'launchctl_oauth=absent\n'
  fi
  printf 'native_slot=%s\n' "$(live_native_kind)"
  if live_fp="$(live_native_access_fingerprint)"; then printf 'native_fingerprint=%s\n' "$live_fp"; fi
  unset secret launch_value
}

# Interactive sessions keep the token they were opened with in their environment, so a
# switch reaches them only when they restart. Processes with their own CLAUDE_CONFIG_DIR
# (services with a dedicated credential) are not managed here and are skipped.
check_open_sessions() {
  want="$1" active="$2" total=0 off=0 pids=""
  while IFS= read -r line; do
    case " $line " in *" CLAUDE_CONFIG_DIR="*) continue ;; esac
    tok="$(printf '%s\n' "$line" | tr ' ' '\n' | sed -n 's/^CLAUDE_CODE_OAUTH_TOKEN=//p' | head -1)"
    [ -n "$tok" ] || continue
    total=$((total + 1))
    if [ "$(fingerprint "$tok")" != "$want" ]; then off=$((off + 1)); pids="$pids ${line%% *}"; fi
  done < <(ps -wwE -U "$(id -u)" -o pid=,command= 2>/dev/null | \
             awk '{sub(/^ +/, ""); c = $2; n = split(c, p, "/");
                   if (p[n] == "claude" || c ~ /\/claude\/versions\/[0-9.]+$/) print}' || true)
  unset tok line
  if [ "$off" -gt 0 ]; then
    echo "[warn] $off of $total open session(s) run on another account (pid$pids): restart them to use '$active'"
  else
    echo "[ok] $total open session(s) with an env token, all on '$active'"
  fi
}

# A setup-token dies a year after it was made, and nothing refreshes it. Warn 30 days ahead, per
# OAuth profile, with the way out; a dead one is a failure because every switch to it breaks.
check_token_expiry() {
  now="$(date +%s)"
  for file in "$PROFILES_DIR"/*.json; do
    [ -f "$file" ] || continue
    [ "$(jq -r '.type' "$file")" = oauth_token ] || continue
    pname="$(jq -r '.name' "$file")"
    psvc="$(jq -r '.keychainService' "$file")"
    created="$(keychain_written_epoch "$psvc")" || { echo "[warn] setup-token of '$pname': write date unreadable, expiry unknown"; continue; }
    ends=$(( created + TOKEN_LIFETIME_DAYS * 86400 ))
    left=$(( (ends - now) / 86400 ))
    day="$(date -r "$ends" +%Y-%m-%d)"
    if [ "$left" -lt 0 ]; then
      echo "[FAIL] setup-token of '$pname' expired around $day (claude setup-token, then: claude-account add-oauth $pname)"; failures=$((failures + 1))
    elif [ "$left" -le 30 ]; then
      echo "[warn] setup-token of '$pname' expires around $day, in $left day(s) (claude setup-token, then: claude-account add-oauth $pname)"
    else
      echo "[ok] setup-token of '$pname' valid until about $day"
    fi
  done
}

cmd_doctor() {
  failures=0
  active="$(active_name 2>/dev/null || true)"
  if [ -z "$active" ]; then
    echo '[FAIL] no active profile'
    return 1
  fi
  load_profile "$active"
  if secret="$(keychain_get "$KEYCHAIN_SERVICE" 2>/dev/null)"; then
    echo '[ok] active profile has a credential in the Keychain'
  else
    echo '[FAIL] profile credential missing from the Keychain'; failures=$((failures + 1))
  fi
  launch_value="$(launchctl getenv CLAUDE_CODE_OAUTH_TOKEN 2>/dev/null || true)"
  if [ -n "$SECURE_DIR" ]; then
    if validate_secure_login; then
      echo '[ok] full login of the active profile is signed in'
    else
      echo "[FAIL] full login of the active profile is missing or signed out (fix: claude-account login $active)"; failures=$((failures + 1))
    fi
    if [ "$(launchctl getenv CLAUDE_SECURESTORAGE_CONFIG_DIR 2>/dev/null || true)" = "$SECURE_DIR" ] && [ -z "$launch_value" ]; then
      echo '[ok] launchctl points to the full login of the active profile'
    else
      echo "[FAIL] launchctl diverges from the active profile (fix: claude-account use $active)"; failures=$((failures + 1))
    fi
  elif [ "$PROFILE_TYPE" = oauth_token ]; then
    if [ -n "${secret:-}" ] && [ "$(fingerprint "$secret")" = "$(fingerprint "$launch_value")" ]; then
      echo '[ok] launchctl points to the active OAuth profile'
    else
      echo '[FAIL] launchctl diverges from the active profile'; failures=$((failures + 1))
    fi
    kind="$(live_native_kind)"
    if [ "$kind" = token ] && [ -n "${secret:-}" ] && \
       [ "$(live_native_access_fingerprint || true)" = "$(fingerprint "$secret")" ]; then
      echo '[ok] native slot carries the active profile token (daemon and background agents on the same account)'
    else
      case "$kind" in
        login) why='a /login sits in the native slot: background agents run on that account' ;;
        absent) why='the native slot is empty: background agents have no credential' ;;
        *) why='the native slot carries another credential: background agents run on another account' ;;
      esac
      echo "[FAIL] $why, not on '$active' (fix: claude-account use $active)"; failures=$((failures + 1))
    fi
  else
    if [ -n "$launch_value" ] || [ -n "$(launchctl getenv CLAUDE_SECURESTORAGE_CONFIG_DIR 2>/dev/null || true)" ]; then
      echo '[FAIL] launchctl still carries another profile (CLAUDE_CODE_OAUTH_TOKEN or CLAUDE_SECURESTORAGE_CONFIG_DIR) while a native profile is active'; failures=$((failures + 1))
    else
      echo '[ok] launchctl carries no OAuth token'
    fi
    if keychain_has "$NATIVE_SERVICE"; then
      live="$(live_native_access_fingerprint || true)"
      if [ -n "$live" ] && [ "$live" = "$(access_fingerprint_of "$KEYCHAIN_SERVICE" || true)" ]; then
        echo '[ok] native credential in the live slot matches the profile archive'
      else
        echo '[warn] live native credential differs from the archive (tokens refreshed since import; run `use` on this profile to re-archive)'
      fi
    else
      echo '[FAIL] active native credential missing'; failures=$((failures + 1))
    fi
  fi
  want=""
  if [ "$PROFILE_TYPE" = oauth_token ] && [ -n "${secret:-}" ]; then want="$(fingerprint "$secret")"; fi
  check_open_sessions "$want" "$active"
  check_token_expiry
  if [ -x "$WRAPPER_BIN" ]; then
    echo '[ok] claude wrapper installed'
  else
    echo '[FAIL] wrapper missing'; failures=$((failures + 1))
  fi
  if grep -q 'claude-account' "$HOME/.zshrc" "$HOME/.zprofile" 2>/dev/null; then
    echo '[ok] shell integration present (.zshrc or .zprofile)'
  else
    echo '[FAIL] shell integration missing from .zshrc and .zprofile'; failures=$((failures + 1))
  fi
  unset secret launch_value
  [ "$failures" -eq 0 ] || return 1
}

apply_profile_env() {
  active="$(active_name 2>/dev/null || true)"
  [ -n "$active" ] || die "no active profile"
  load_profile "$active"
  case "$PROFILE_TYPE" in
    oauth_token)
      if [ -n "$SECURE_DIR" ]; then
        unset CLAUDE_CODE_OAUTH_TOKEN
        export CLAUDE_SECURESTORAGE_CONFIG_DIR="$SECURE_DIR"
        return 0
      fi
      token="$(keychain_get "$KEYCHAIN_SERVICE")" || die "OAuth token missing from Keychain"
      export CLAUDE_CODE_OAUTH_TOKEN="$token"
      unset token
      ;;
    native_archive)
      unset CLAUDE_CODE_OAUTH_TOKEN
      ;;
  esac
  unset CLAUDE_SECURESTORAGE_CONFIG_DIR
}

# In economia the new session starts with --effort medium (the running session
# cannot be changed from outside; the hooks handle subagents and workflows).
# An explicit --effort on the command line always wins.
regime_effort_args() {
  local a
  for a in "$@"; do
    case "$a" in --) break ;; --effort|--effort=*) return ;; esac
  done
  local bin r
  bin="$(dirname "$0")/claude-account-regime"
  [ -x "$bin" ] || return
  r="$("$bin" --json 2>/dev/null | jq -r '.regime // ""' 2>/dev/null)" || return
  case "$r" in economia|trava) printf -- '--effort medium' ;; esac
}

cmd_exec() {
  apply_profile_env
  local extra; extra="$(regime_effort_args "$@")"
  case "${1:-} ${2:-}" in
    "stop "*|"rm "*|"kill "*|"daemon stop"|"daemon shutdown") log_stop_reason "claude $*" ;;
  esac
  [ -n "$extra" ] && note "quota in a restrictive regime: this session opens with --effort medium (pass --effort to override)" >&2
  # shellcheck disable=SC2086
  exec "$NATIVE_BIN" $extra "$@"
}

cmd_probe() {
  apply_profile_env
  "$NATIVE_BIN" auth status
  "$NATIVE_BIN" -p 'Reply with exactly: CLAUDE-ACCOUNT-OK'
}

# Minimal inference (1 output token, haiku) whose response headers carry the
# unified rate-limit state. Prints one line per profile; never the token.
measure_one() {
  name="$1"
  load_profile "$name"
  service="$KEYCHAIN_SERVICE"
  [ "$PROFILE_TYPE" = native_archive ] && service="$MEASURE_SERVICE"
  if [ -z "$service" ] || ! token="$(keychain_get "$service")"; then
    printf '%s,unmeasurable,,,,,,,,\n' "$name"
    return 0
  fi
  measure_token_line "$name" "$token"
  unset token
}

cmd_measure() {
  names=()
  if [ "$#" -gt 0 ]; then
    names=("$@")
  else
    for file in "$PROFILES_DIR"/*.json; do
      [ -f "$file" ] || continue
      names+=("$(jq -r '.name' "$file")")
    done
  fi
  [ "${#names[@]}" -gt 0 ] || { note "0 profiles to measure"; return 0; }
  echo "profiles[${#names[@]}]{name,status,http,util_5h,reset_5h,util_7d,reset_7d,overage,overage_in_use,measured_at}:"
  for n in "${names[@]}"; do
    printf '  '
    measure_one "$n"
  done
}

usage() {
  cat <<'EOF'
Usage:
  claude-account add-oauth <name> [--existing]      register a profile from a setup-token
                                                    (--existing: Keychain item already stored)
  claude-account add-oauth <name> --measure-for <p> use this token only to measure profile <p>
  claude-account wizard                             interactive screen: switch, renew, doctor (arrow keys)
  claude-account renew <name> [--yes]               guided renewal of an expired setup-token (browser)
  claude-account import-native [name] [--last-login] import the current /login (or the last one
                                                    displaced by `use`) as a profile
  claude-account use <name> [--no-restart|--keep-agents|--move-agents]
                                                    switch every auth layer, the native slot
                                                    included; moves background sessions to the new
                                                    account (bg-restart) and restarts Orca if
                                                    installed. --keep-agents leaves them on the old
                                                    one; --no-restart --move-agents moves them only
  claude-account login <name>                       one-time full login for an OAuth profile
                                                    (claude.ai connectors; own Keychain item)
  claude-account bg-restart [--force] [--if-pending] move background sessions to the active
                                                    profile, same ids (deferred while one is busy)
  claude-account bg-status                          active vs daemon profile, sessions, pending move
  claude-account list
  claude-account status
  claude-account doctor
  claude-account probe
  claude-account measure [name...]                  rate-limit state per profile (headers, no secrets)
  claude-account exec [args...]                     run the native binary under the active profile
  claude-account regime [--json|livre|economia|auto] what the quota allows right now (see claude-account-regime --help)

Exit codes: 0 ok, 1 error, 2 usage error.
Override the native binary path with CLAUDE_NATIVE_BIN=/path/to/claude.
EOF
}

ensure_base
command_name="${1:-help}"
shift || true
case "$command_name" in
  add-oauth) cmd_add_oauth "$@" ;;
  import-native) cmd_import_native "$@" ;;
  use) cmd_use "$@" ;;
  renew) cmd_renew "$@" ;;
  wizard) cmd_wizard "$@" ;;
  list) cmd_list "$@" ;;
  status) cmd_status "$@" ;;
  doctor) cmd_doctor "$@" ;;
  probe) cmd_probe "$@" ;;
  measure) cmd_measure "$@" ;;
  exec) cmd_exec "$@" ;;
  login) cmd_login "$@" ;;
  bg-restart) cmd_bg_restart "$@" ;;
  bg-status) cmd_bg_status "$@" ;;
  _bg-restart-worker) cmd_bg_restart_worker "$@" ;;
  regime) exec "$(dirname "$0")/claude-account-regime" "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; usage_error "unknown command: $command_name" ;;
esac
