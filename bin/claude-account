#!/usr/bin/env bash
# Profile manager for multiple Claude Code accounts on macOS.
# Secrets live exclusively in the macOS Keychain; this file never contains tokens.
#
# `use <name>` switches every auth layer atomically (Keychain slots, launchctl,
# ~/.claude.json metadata, Claude daemon). An OAuth profile is also projected into
# the native Keychain slot, which is where `claude agents` and background sessions
# read their credential. By default the daemon restarts and, when Orca is
# installed, Orca too; `--no-restart` stops nothing. The headless switcher
# (claude-account-autoswitch) always passes `--no-restart`.
#
# `measure` reads the real rate-limit state of every profile from the
# anthropic-ratelimit-unified-* headers (a setup-token has inference scope only,
# so /api/oauth/usage is not available to it), which is what
# claude-account-autoswitch uses to decide.
set -euo pipefail

CONFIG_DIR="${CLAUDE_ACCOUNT_HOME:-$HOME/.config/claude-account}"
PROFILES_DIR="$CONFIG_DIR/profiles"
ACTIVE_FILE="$CONFIG_DIR/active"
WRAPPER_BIN="$HOME/bin/claude"
NATIVE_SERVICE="Claude Code-credentials"
MEASURE_MODEL="claude-haiku-4-5-20251001"
MEASURE_SYSTEM="You are Claude Code, Anthropic's official CLI for Claude."

die() { printf 'claude-account: ERROR: %s\n' "$*" >&2; exit 1; }
usage_error() { printf 'claude-account: ERROR: %s\n' "$*" >&2; exit 2; }
note() { printf 'claude-account: %s\n' "$*"; }

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

find_native_bin() {
  if [ -n "${CLAUDE_NATIVE_BIN:-}" ]; then
    printf '%s\n' "$CLAUDE_NATIVE_BIN"
    return 0
  fi
  set -- \
    "$HOME/.local/bin/claude-stable" \
    "$HOME/.local/bin/claude" \
    "$HOME/.claude/local/claude" \
    /opt/homebrew/bin/claude \
    /usr/local/bin/claude
  for cand in "$@"; do
    if [ -x "$cand" ] && [ "$cand" != "$WRAPPER_BIN" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  while IFS= read -r cand; do
    if [ -x "$cand" ] && [ "$cand" != "$WRAPPER_BIN" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done < <(command -v -a claude 2>/dev/null || true)
  return 1
}

NATIVE_BIN="$(find_native_bin || true)"

ensure_base() {
  mkdir -p "$PROFILES_DIR"
  chmod 700 "$CONFIG_DIR" "$PROFILES_DIR" 2>/dev/null || true
  [ -n "$NATIVE_BIN" ] && [ -x "$NATIVE_BIN" ] || \
    die "native Claude Code binary not found; set CLAUDE_NATIVE_BIN=/path/to/claude"
  need jq
  need security
}

validate_name() {
  case "${1:-}" in
    ''|*[!a-zA-Z0-9._-]*) usage_error "invalid profile name: use letters, digits, dot, _ or -" ;;
  esac
}

profile_file() { printf '%s/%s.json' "$PROFILES_DIR" "$1"; }

load_profile() {
  PROFILE_NAME="$1"
  validate_name "$PROFILE_NAME"
  PROFILE_FILE="$(profile_file "$PROFILE_NAME")"
  [ -f "$PROFILE_FILE" ] || die "profile does not exist: $PROFILE_NAME"
  PROFILE_TYPE="$(jq -er '.type' "$PROFILE_FILE")"
  KEYCHAIN_SERVICE="$(jq -er '.keychainService' "$PROFILE_FILE")"
  PROFILE_LABEL="$(jq -r '.label // .name' "$PROFILE_FILE")"
  MEASURE_SERVICE="$(jq -r '.measureKeychainService // empty' "$PROFILE_FILE")"
  PROFILE_SUBSCRIPTION="$(jq -r '.subscription // "max"' "$PROFILE_FILE")"
  case "$PROFILE_TYPE" in
    oauth_token|native_archive) ;;
    *) die "unknown profile type in $PROFILE_FILE: $PROFILE_TYPE" ;;
  esac
}

active_name() {
  [ -f "$ACTIVE_FILE" ] || return 1
  tr -d '[:space:]' < "$ACTIVE_FILE"
}

set_active() {
  tmp="$(mktemp "$CONFIG_DIR/.active.XXXXXX")"
  printf '%s\n' "$1" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$ACTIVE_FILE"
}

keychain_get() {
  security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null
}

keychain_has() {
  security find-generic-password -a "$USER" -s "$1" >/dev/null 2>&1
}

fingerprint() {
  printf '%s' "$1" | shasum -a 256 | cut -c1-12
}

write_profile() {
  name="$1" type="$2" service="$3" label="$4" measure="${5:-}"
  file="$(profile_file "$name")"
  tmp="$(mktemp "$PROFILES_DIR/.profile.XXXXXX")"
  jq -n \
    --arg name "$name" \
    --arg type "$type" \
    --arg service "$service" \
    --arg label "$label" \
    --arg measure "$measure" \
    '{version:2,name:$name,type:$type,keychainService:$service,label:$label}
     + (if $measure != "" then {measureKeychainService:$measure} else {} end)' > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"
}

# Copies one Keychain item into another, verified by fingerprint.
copy_keychain_item() {
  from="$1" to="$2"
  blob="$(keychain_get "$from")" || die "Keychain item missing: $from"
  security add-generic-password -U -a "$USER" -s "$to" -w "$blob" >/dev/null
  check="$(keychain_get "$to")"
  [ "$(fingerprint "$blob")" = "$(fingerprint "$check")" ] || die "copied credential does not match: $to"
  unset blob check
}

# Copies the live native credential into an archive slot, verified by fingerprint.
archive_native_if_present() {
  if keychain_has "$NATIVE_SERVICE"; then copy_keychain_item "$NATIVE_SERVICE" "$1"; fi
}

# The live native slot is the one credential every Claude Code process reads alike. The
# daemon behind `claude agents` and the background sessions it spawns do not inherit
# CLAUDE_CODE_OAUTH_TOKEN from the shell: they authenticate from this slot. Besides the
# account login the blob carries other keys (MCP server OAuth lives there), and every
# write below keeps them.
live_native_blob() { keychain_get "$NATIVE_SERVICE" || true; }

# absent | login (a real /login, with a refresh token) | token (a projected setup-token) | other
live_native_kind() {
  kind_blob="$(live_native_blob)"
  if [ -z "$kind_blob" ]; then
    echo absent
  else
    printf '%s' "$kind_blob" | jq -r '
      if type != "object" or (.claudeAiOauth | type) != "object" then "other"
      elif (.claudeAiOauth.refreshToken // "") != "" then "login"
      else "token" end' 2>/dev/null || echo other
  fi
  unset kind_blob
}

access_fingerprint_of() {
  access="$(keychain_get "$1" | jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null || true)"
  [ -n "$access" ] || { unset access; return 1; }
  fingerprint "$access"
  unset access
}

live_native_access_fingerprint() { access_fingerprint_of "$NATIVE_SERVICE"; }

# A setup-token lives one year. Its birth is read from the Keychain item's modification date
# (`add-oauth` rewrites the item with -U, which keeps the creation date but moves this one), so the
# projection can carry the token's real expiry. The daemon behind `claude agents` refreshes a
# credential only when its expiry is near, and with no refresh token that refresh fails and the
# daemon drops the credential: an expiry earlier than the token's would break the agents while the
# token still works (measured on 2.1.267: the daemon log reads "proactive refresh failed,
# signalling re-auth required"). A plain session ignores the expiry when there is no refresh token.
TOKEN_LIFETIME_DAYS=364
PROJECTION_FALLBACK_DAYS=330

keychain_written_epoch() {
  stamp="$(security find-generic-password -a "$USER" -s "$1" 2>/dev/null \
    | sed -n 's/.*"mdat"<timedate>=[^"]*"\([0-9]\{14\}\)Z.*/\1/p' | head -1)"
  [ -n "$stamp" ] || return 1
  date -j -u -f '%Y%m%d%H%M%S' "$stamp" +%s 2>/dev/null
}

# Epoch seconds when the setup-token in this Keychain item stops working.
token_expiry_epoch() {
  if created="$(keychain_written_epoch "$1")"; then
    printf '%s\n' $(( created + TOKEN_LIFETIME_DAYS * 86400 ))
  else
    printf '%s\n' $(( $(date +%s) + PROJECTION_FALLBACK_DAYS * 86400 ))
  fi
}

# Writes an OAuth profile into the live slot as a native-shaped credential: the setup-token
# as access token, no refresh token (a setup-token is long-lived and has nothing to refresh
# with) and the token's own expiry, so the daemon never tries to refresh it before it dies.
project_token_into_native() {
  expires=$(( $(token_expiry_epoch "$KEYCHAIN_SERVICE") * 1000 ))
  base="$(live_native_blob)"
  printf '%s' "$base" | jq -e 'type == "object"' >/dev/null 2>&1 || base='{}'
  blob="$(printf '%s' "$base" | CA_TOKEN="$1" jq -c --argjson e "$expires" --arg s "$PROFILE_SUBSCRIPTION" \
    '.claudeAiOauth = {accessToken: env.CA_TOKEN, refreshToken: null, expiresAt: $e,
                       scopes: ["user:inference"], subscriptionType: $s}')"
  security add-generic-password -U -a "$USER" -s "$NATIVE_SERVICE" -w "$blob" >/dev/null
  unset base blob
  [ "$(live_native_access_fingerprint || true)" = "$(fingerprint "$1")" ] || \
    die "projected credential does not match the profile token"
}

# Restores an archived login into the live slot, keeping the other keys of the live blob.
restore_native_active() {
  blob="$(keychain_get "$1")" || die "native archive missing from Keychain"
  live="$(live_native_blob)"
  if printf '%s' "$live" | jq -e 'type == "object"' >/dev/null 2>&1; then
    blob="$(printf '%s\n%s\n' "$blob" "$live" | jq -cs '.[0] + (.[1] | del(.claudeAiOauth))')"
  fi
  security add-generic-password -U -a "$USER" -s "$NATIVE_SERVICE" -w "$blob" >/dev/null
  unset blob live
}

LAST_LOGIN_ARCHIVE="Claude Code-credentials-last-login-archive"

# A real /login in the live slot is never lost. When the active profile is native it owns
# the slot, and its archive is refreshed (the login rotates its refresh token while it sits
# there). Otherwise the login came from a /login inside Claude Code: it is kept in a
# last-login archive that `import-native <name> --last-login` turns into a profile.
preserve_live_login() {
  [ "$(live_native_kind)" = login ] || return 0
  current="$(active_name 2>/dev/null || true)"
  if [ -n "$current" ] && [ -f "$(profile_file "$current")" ] && \
     [ "$(jq -r '.type' "$(profile_file "$current")")" = native_archive ]; then
    archive_native_if_present "$(jq -r '.keychainService' "$(profile_file "$current")")"
    return 0
  fi
  archive_native_if_present "$LAST_LOGIN_ARCHIVE"
  note "a /login found in the native slot was kept as '$LAST_LOGIN_ARCHIVE' (claude-account import-native <name> --last-login)"
}

# True when the caller descends from the Claude daemon (a background agent running us):
# a full daemon stop would terminate the caller itself.
inside_background_agent() {
  pid=$$
  while [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
    case "$(ps -o command= -p "$pid" 2>/dev/null || true)" in
      *"daemon run"*|*bg-pty-host*) return 0 ;;
    esac
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
  done
  return 1
}

# New background agents start from the slot the daemon hands them. A full stop ends every
# running agent; --keep-workers (for --keep-agents, and whenever we run inside an agent)
# keeps them alive on the account they started with.
restart_claude_daemon() {
  if [ "$1" = true ] || inside_background_agent; then
    "$NATIVE_BIN" daemon stop --any --keep-workers >/dev/null 2>&1 || true
    note "daemon restarted; running agents keep their account until respawned (claude respawn)"
  else
    "$NATIVE_BIN" daemon stop --any >/dev/null 2>&1 || true
  fi
}

strip_stale_account_metadata() {
  file="$HOME/.claude.json"
  [ -f "$file" ] || return 0
  jq -e 'has("oauthAccount")' "$file" >/dev/null 2>&1 || return 0
  stamp="$(date +%Y%m%d-%H%M%S)"
  cp "$file" "$file.bak-claude-account-$stamp"
  tmp="$(mktemp)"
  jq 'del(.oauthAccount)' "$file" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"
  note "previous oauthAccount metadata archived at $file.bak-claude-account-$stamp"
}

schedule_orca_restart() {
  helper="$HOME/.local/lib/claude-account-manager/restart-orca.sh"
  if [ ! -x "$helper" ]; then
    note "restart your terminal sessions (and Orca, if you use it) for the switch to take effect"
    return 0
  fi
  nohup "$helper" >/tmp/claude-account-restart-orca.log 2>&1 </dev/null &
  note "Orca will restart shortly"
}

validate_token() {
  auth_json="$(CLAUDE_CODE_OAUTH_TOKEN="$1" "$NATIVE_BIN" auth status 2>/dev/null || true)"
  [ "$(printf '%s' "$auth_json" | jq -r '.loggedIn // false' 2>/dev/null)" = true ]
}

cmd_add_oauth() {
  name="${1:-}"
  shift || true
  existing=false
  measure_for=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --existing) existing=true ;;
      --measure-for) shift; measure_for="${1:-}" ;;
      *) usage_error "unknown option: $1" ;;
    esac
    shift
  done
  validate_name "$name"
  service="Claude Code OAuth Token - $name"
  if [ "$existing" = true ]; then
    token="$(keychain_get "$service")" || die "no Keychain item named '$service'"
  else
    printf 'Paste the setup-token for profile %s (hidden input): ' "$name" >&2
    IFS= read -r -s token
    printf '\n' >&2
  fi
  case "$token" in
    sk-ant-oat01-*) ;;
    *) unset token; die "unexpected setup-token format" ;;
  esac
  validate_token "$token" || { unset token; die "token rejected by Claude Code"; }
  [ "$existing" = true ] || security add-generic-password -U -a "$USER" -s "$service" -w "$token" >/dev/null
  unset token
  if [ -n "$measure_for" ]; then
    # This token only measures the rate-limit state of a native profile of the
    # same account; it never becomes the active credential by itself.
    validate_name "$measure_for"
    [ -f "$(profile_file "$measure_for")" ] || die "profile does not exist: $measure_for"
    tmp="$(mktemp "$PROFILES_DIR/.profile.XXXXXX")"
    jq --arg m "$service" '.measureKeychainService = $m' "$(profile_file "$measure_for")" > "$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$(profile_file "$measure_for")"
    note "profile '$measure_for' now measures through the Keychain item '$service'"
    return 0
  fi
  write_profile "$name" oauth_token "$service" "$name (OAuth setup-token)"
  note "OAuth profile '$name' stored in the Keychain"
}

cmd_import_native() {
  name="${1:-primary}"
  shift || true
  validate_name "$name"
  from="$NATIVE_SERVICE"
  case "${1:-}" in
    '') ;;
    --last-login) from="$LAST_LOGIN_ARCHIVE" ;;
    *) usage_error "unknown option: $1" ;;
  esac
  keychain_get "$from" | jq -e '(.claudeAiOauth.refreshToken // "") != ""' >/dev/null 2>&1 || \
    die "'$from' holds no /login (only a projected setup-token or MCP keys); log in with /login first"
  service="Claude Code-credentials-$name-archive"
  copy_keychain_item "$from" "$service"
  email=""
  if [ "$from" = "$NATIVE_SERVICE" ]; then
    email="$(CLAUDE_CODE_OAUTH_TOKEN='' "$NATIVE_BIN" auth status 2>/dev/null | jq -r '.email // empty' || true)"
  fi
  write_profile "$name" native_archive "$service" "$name (native login${email:+ $email})"
  note "native credential imported as profile '$name'${email:+ ($email)}"
}

cmd_use() {
  name="${1:-}"
  shift || true
  restart=true
  keep_agents=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --restart-orca) restart=true ;;
      --no-restart) restart=false ;;
      --keep-agents) keep_agents=true ;;
      *) usage_error "unknown option: $1" ;;
    esac
    shift
  done
  load_profile "$name"

  # Validate before touching any layer.
  case "$PROFILE_TYPE" in
    oauth_token)
      token="$(keychain_get "$KEYCHAIN_SERVICE")" || die "token missing from Keychain: $KEYCHAIN_SERVICE"
      validate_token "$token" || { unset token; die "OAuth for profile '$name' was rejected"; }
      ;;
    native_archive)
      keychain_get "$KEYCHAIN_SERVICE" | jq -e '(.claudeAiOauth.refreshToken // "") != ""' >/dev/null 2>&1 || \
        die "the archive of profile '$name' holds no /login; log in with /login, then: claude-account import-native $name"
      ;;
  esac

  preserve_live_login
  case "$PROFILE_TYPE" in
    oauth_token)
      project_token_into_native "$token"
      launchctl setenv CLAUDE_CODE_OAUTH_TOKEN "$token"
      strip_stale_account_metadata
      unset token
      ;;
    native_archive)
      launchctl unsetenv CLAUDE_CODE_OAUTH_TOKEN >/dev/null 2>&1 || true
      restore_native_active "$KEYCHAIN_SERVICE"
      ;;
  esac

  set_active "$name"
  note "active profile: $name ($PROFILE_TYPE)"
  if [ "$restart" = true ]; then
    restart_claude_daemon "$keep_agents"
    schedule_orca_restart
  else
    note "--no-restart: nothing was stopped; new sessions use '$name', open sessions and running agents keep their account until restarted"
  fi
}

cmd_list() {
  active="$(active_name 2>/dev/null || true)"
  found=false
  for file in "$PROFILES_DIR"/*.json; do
    [ -f "$file" ] || continue
    found=true
    name="$(jq -r '.name' "$file")"
    type="$(jq -r '.type' "$file")"
    label="$(jq -r '.label // .name' "$file")"
    mark=' '
    [ "$name" = "$active" ] && mark='*'
    printf '%s %-16s %-15s %s\n' "$mark" "$name" "$type" "$label"
  done
  [ "$found" = true ] || note "no profiles registered (0 profiles)"
}

cmd_status() {
  active="$(active_name 2>/dev/null || true)"
  [ -n "$active" ] || die "no active profile"
  load_profile "$active"
  printf 'profile=%s\ntype=%s\nlabel=%s\n' "$PROFILE_NAME" "$PROFILE_TYPE" "$PROFILE_LABEL"
  if secret="$(keychain_get "$KEYCHAIN_SERVICE" 2>/dev/null)"; then
    printf 'keychain=present\nfingerprint=%s\n' "$(fingerprint "$secret")"
  else
    printf 'keychain=absent\n'
  fi
  launch_value="$(launchctl getenv CLAUDE_CODE_OAUTH_TOKEN 2>/dev/null || true)"
  if [ -n "$launch_value" ]; then
    printf 'launchctl_oauth=present\nlaunchctl_fingerprint=%s\n' "$(fingerprint "$launch_value")"
  else
    printf 'launchctl_oauth=absent\n'
  fi
  printf 'native_slot=%s\n' "$(live_native_kind)"
  if live_fp="$(live_native_access_fingerprint)"; then printf 'native_fingerprint=%s\n' "$live_fp"; fi
  unset secret launch_value
}

# Interactive sessions keep the token they were opened with in their environment, so a
# switch reaches them only when they restart. Processes with their own CLAUDE_CONFIG_DIR
# (services with a dedicated credential) are not managed here and are skipped.
check_open_sessions() {
  want="$1" active="$2" total=0 off=0 pids=""
  while IFS= read -r line; do
    case " $line " in *" CLAUDE_CONFIG_DIR="*) continue ;; esac
    tok="$(printf '%s\n' "$line" | tr ' ' '\n' | sed -n 's/^CLAUDE_CODE_OAUTH_TOKEN=//p' | head -1)"
    [ -n "$tok" ] || continue
    total=$((total + 1))
    if [ "$(fingerprint "$tok")" != "$want" ]; then off=$((off + 1)); pids="$pids ${line%% *}"; fi
  done < <(ps -wwE -U "$(id -u)" -o pid=,command= 2>/dev/null | \
             awk '{sub(/^ +/, ""); c = $2; n = split(c, p, "/");
                   if (p[n] == "claude" || c ~ /\/claude\/versions\/[0-9.]+$/) print}' || true)
  unset tok line
  if [ "$off" -gt 0 ]; then
    echo "[warn] $off of $total open session(s) run on another account (pid$pids): restart them to use '$active'"
  else
    echo "[ok] $total open session(s) with an env token, all on '$active'"
  fi
}

# A setup-token dies a year after it was made, and nothing refreshes it. Warn 30 days ahead, per
# OAuth profile, with the way out; a dead one is a failure because every switch to it breaks.
check_token_expiry() {
  now="$(date +%s)"
  for file in "$PROFILES_DIR"/*.json; do
    [ -f "$file" ] || continue
    [ "$(jq -r '.type' "$file")" = oauth_token ] || continue
    pname="$(jq -r '.name' "$file")"
    psvc="$(jq -r '.keychainService' "$file")"
    created="$(keychain_written_epoch "$psvc")" || { echo "[warn] setup-token of '$pname': write date unreadable, expiry unknown"; continue; }
    ends=$(( created + TOKEN_LIFETIME_DAYS * 86400 ))
    left=$(( (ends - now) / 86400 ))
    day="$(date -r "$ends" +%Y-%m-%d)"
    if [ "$left" -lt 0 ]; then
      echo "[FAIL] setup-token of '$pname' expired around $day (claude setup-token, then: claude-account add-oauth $pname)"; failures=$((failures + 1))
    elif [ "$left" -le 30 ]; then
      echo "[warn] setup-token of '$pname' expires around $day, in $left day(s) (claude setup-token, then: claude-account add-oauth $pname)"
    else
      echo "[ok] setup-token of '$pname' valid until about $day"
    fi
  done
}

cmd_doctor() {
  failures=0
  active="$(active_name 2>/dev/null || true)"
  if [ -z "$active" ]; then
    echo '[FAIL] no active profile'
    return 1
  fi
  load_profile "$active"
  if secret="$(keychain_get "$KEYCHAIN_SERVICE" 2>/dev/null)"; then
    echo '[ok] active profile has a credential in the Keychain'
  else
    echo '[FAIL] profile credential missing from the Keychain'; failures=$((failures + 1))
  fi
  launch_value="$(launchctl getenv CLAUDE_CODE_OAUTH_TOKEN 2>/dev/null || true)"
  if [ "$PROFILE_TYPE" = oauth_token ]; then
    if [ -n "${secret:-}" ] && [ "$(fingerprint "$secret")" = "$(fingerprint "$launch_value")" ]; then
      echo '[ok] launchctl points to the active OAuth profile'
    else
      echo '[FAIL] launchctl diverges from the active profile'; failures=$((failures + 1))
    fi
    kind="$(live_native_kind)"
    if [ "$kind" = token ] && [ -n "${secret:-}" ] && \
       [ "$(live_native_access_fingerprint || true)" = "$(fingerprint "$secret")" ]; then
      echo '[ok] native slot carries the active profile token (daemon and background agents on the same account)'
    else
      case "$kind" in
        login) why='a /login sits in the native slot: background agents run on that account' ;;
        absent) why='the native slot is empty: background agents have no credential' ;;
        *) why='the native slot carries another credential: background agents run on another account' ;;
      esac
      echo "[FAIL] $why, not on '$active' (fix: claude-account use $active)"; failures=$((failures + 1))
    fi
  else
    if [ -n "$launch_value" ]; then
      echo '[FAIL] launchctl still carries CLAUDE_CODE_OAUTH_TOKEN while a native profile is active'; failures=$((failures + 1))
    else
      echo '[ok] launchctl carries no OAuth token'
    fi
    if keychain_has "$NATIVE_SERVICE"; then
      live="$(live_native_access_fingerprint || true)"
      if [ -n "$live" ] && [ "$live" = "$(access_fingerprint_of "$KEYCHAIN_SERVICE" || true)" ]; then
        echo '[ok] native credential in the live slot matches the profile archive'
      else
        echo '[warn] live native credential differs from the archive (tokens refreshed since import; run `use` on this profile to re-archive)'
      fi
    else
      echo '[FAIL] active native credential missing'; failures=$((failures + 1))
    fi
  fi
  want=""
  if [ "$PROFILE_TYPE" = oauth_token ] && [ -n "${secret:-}" ]; then want="$(fingerprint "$secret")"; fi
  check_open_sessions "$want" "$active"
  check_token_expiry
  if [ -x "$WRAPPER_BIN" ]; then
    echo '[ok] claude wrapper installed'
  else
    echo '[FAIL] wrapper missing'; failures=$((failures + 1))
  fi
  if grep -q 'claude-account' "$HOME/.zshrc" "$HOME/.zprofile" 2>/dev/null; then
    echo '[ok] shell integration present (.zshrc or .zprofile)'
  else
    echo '[FAIL] shell integration missing from .zshrc and .zprofile'; failures=$((failures + 1))
  fi
  unset secret launch_value
  [ "$failures" -eq 0 ] || return 1
}

apply_profile_env() {
  active="$(active_name 2>/dev/null || true)"
  [ -n "$active" ] || die "no active profile"
  load_profile "$active"
  case "$PROFILE_TYPE" in
    oauth_token)
      token="$(keychain_get "$KEYCHAIN_SERVICE")" || die "OAuth token missing from Keychain"
      export CLAUDE_CODE_OAUTH_TOKEN="$token"
      unset token
      ;;
    native_archive)
      unset CLAUDE_CODE_OAUTH_TOKEN
      ;;
  esac
}

# In economia the new session starts with --effort medium (the running session
# cannot be changed from outside; the hooks handle subagents and workflows).
# An explicit --effort on the command line always wins.
regime_effort_args() {
  local a
  for a in "$@"; do
    case "$a" in --) break ;; --effort|--effort=*) return ;; esac
  done
  local bin r
  bin="$(dirname "$0")/claude-account-regime"
  [ -x "$bin" ] || return
  r="$("$bin" --json 2>/dev/null | jq -r '.regime // ""' 2>/dev/null)" || return
  case "$r" in economia|trava) printf -- '--effort medium' ;; esac
}

cmd_exec() {
  apply_profile_env
  local extra; extra="$(regime_effort_args "$@")"
  [ -n "$extra" ] && note "quota in a restrictive regime: this session opens with --effort medium (pass --effort to override)" >&2
  # shellcheck disable=SC2086
  exec "$NATIVE_BIN" $extra "$@"
}

cmd_probe() {
  apply_profile_env
  "$NATIVE_BIN" auth status
  "$NATIVE_BIN" -p 'Reply with exactly: CLAUDE-ACCOUNT-OK'
}

# Minimal inference (1 output token, haiku) whose response headers carry the
# unified rate-limit state. Prints one line per profile; never the token.
measure_one() {
  name="$1"
  load_profile "$name"
  service="$KEYCHAIN_SERVICE"
  [ "$PROFILE_TYPE" = native_archive ] && service="$MEASURE_SERVICE"
  if [ -z "$service" ] || ! token="$(keychain_get "$service")"; then
    printf '%s,unmeasurable,,,,,,,,\n' "$name"
    return 0
  fi
  hdr="$(mktemp "${TMPDIR:-/tmp}/claude-account-measure.XXXXXX")"
  http="$(curl -s -o /dev/null -D "$hdr" -w '%{http_code}' --max-time 20 \
    https://api.anthropic.com/v1/messages \
    -H "authorization: Bearer $token" \
    -H "anthropic-version: 2023-06-01" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "content-type: application/json" \
    -d "$(jq -cn --arg m "$MEASURE_MODEL" --arg s "$MEASURE_SYSTEM" \
      '{model:$m,max_tokens:1,system:[{type:"text",text:$s}],messages:[{role:"user",content:"."}]}')" \
    2>/dev/null || printf '000')"
  unset token
  h() { grep -i "^anthropic-ratelimit-unified-$1:" "$hdr" | head -1 | cut -d: -f2- | tr -d ' \r' || true; }
  s5="$(h 5h-status)"; u5="$(h 5h-utilization)"; r5="$(h 5h-reset)"
  s7="$(h 7d-status)"; u7="$(h 7d-utilization)"; r7="$(h 7d-reset)"
  so="$(h overage-status)"; ou="$(h overage-in-use)"
  rm -f "$hdr"
  status=unknown
  if [ "$http" = 429 ]; then status=rejected
  elif [ "$http" -ge 200 ] 2>/dev/null && [ "$http" -lt 300 ]; then
    if [ "$s5" = rejected ] || [ "$s7" = rejected ]; then status=rejected
    elif [ "$s5" = allowed ] && [ "$s7" = allowed ]; then status=allowed
    fi
  fi
  printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
    "$name" "$status" "$http" "${u5:-}" "${r5:-}" "${u7:-}" "${r7:-}" "${so:-}" "${ou:-false}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

cmd_measure() {
  names=()
  if [ "$#" -gt 0 ]; then
    names=("$@")
  else
    for file in "$PROFILES_DIR"/*.json; do
      [ -f "$file" ] || continue
      names+=("$(jq -r '.name' "$file")")
    done
  fi
  [ "${#names[@]}" -gt 0 ] || { note "0 profiles to measure"; return 0; }
  echo "profiles[${#names[@]}]{name,status,http,util_5h,reset_5h,util_7d,reset_7d,overage,overage_in_use,measured_at}:"
  for n in "${names[@]}"; do
    printf '  '
    measure_one "$n"
  done
}

usage() {
  cat <<'EOF'
Usage:
  claude-account add-oauth <name> [--existing]      register a profile from a setup-token
                                                    (--existing: Keychain item already stored)
  claude-account add-oauth <name> --measure-for <p> use this token only to measure profile <p>
  claude-account import-native [name] [--last-login] import the current /login (or the last one
                                                    displaced by `use`) as a profile
  claude-account use <name> [--no-restart|--keep-agents]  switch every auth layer, the native slot
                                                    included; restarts the daemon (and Orca if
                                                    installed). --keep-agents keeps running agents
  claude-account list
  claude-account status
  claude-account doctor
  claude-account probe
  claude-account measure [name...]                  rate-limit state per profile (headers, no secrets)
  claude-account exec [args...]                     run the native binary under the active profile
  claude-account regime [--json|livre|economia|auto] what the quota allows right now (see claude-account-regime --help)

Exit codes: 0 ok, 1 error, 2 usage error.
Override the native binary path with CLAUDE_NATIVE_BIN=/path/to/claude.
EOF
}

ensure_base
command_name="${1:-help}"
shift || true
case "$command_name" in
  add-oauth) cmd_add_oauth "$@" ;;
  import-native) cmd_import_native "$@" ;;
  use) cmd_use "$@" ;;
  list) cmd_list "$@" ;;
  status) cmd_status "$@" ;;
  doctor) cmd_doctor "$@" ;;
  probe) cmd_probe "$@" ;;
  measure) cmd_measure "$@" ;;
  exec) cmd_exec "$@" ;;
  regime) exec "$(dirname "$0")/claude-account-regime" "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; usage_error "unknown command: $command_name" ;;
esac
